# Copy to .env (never commit .env). Every contact-form enquiry is emailed to ENQUIRY_TO through Gmail.
# SMTP_PASSWORD must be a Gmail App Password for SMTP_USER, not the normal account password:
# Google Account -> Security -> 2-Step Verification (turn on) -> App passwords -> create one for "Calcus website".
SMTP_USER=calcusaisolutions@gmail.com
SMTP_PASSWORD=
ENQUIRY_TO=calcusaisolutions@gmail.com

# "I don't know how?" advisor: Claude reads the visitor's line and suggests a package, services and AI ideas.
# Create a key at https://platform.claude.com (Settings -> API keys). Without it the box hands visitors to the form.
ANTHROPIC_API_KEY=
# Most advisor questions answered per day across the whole site (each visitor also gets 5/minute and 30/day).
ADVISOR_DAILY_LIMIT=500
# Set to 1 only when a reverse proxy (Caddy, nginx, a load balancer) sits in front, so limits apply per real visitor.
TRUST_PROXY=
