{
  "name": "calcus-ai-studio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "catalog": "node scripts/build-catalog.mjs",
    "dev": "npm run catalog && vite --host 0.0.0.0",
    "build": "npm run catalog && vite build && vite build --ssr src/entry-server.js --outDir dist-server && node scripts/prerender.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "bots": "node scripts/generate-bots.mjs"
  },
  "dependencies": {
    "@lucide/svelte": "^1.54.0",
    "svelte": "^5.0.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@dicebear/collection": "^9.4.2",
    "@dicebear/core": "^9.4.3",
    "@lobehub/icons-static-svg": "^1.95.1",
    "@sveltejs/vite-plugin-svelte": "^6.0.0",
    "vite": "^7.0.0"
  }
}
